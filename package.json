    "@vitest/coverage-v8": "^4.1.7",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "turbo": "^2.8.13",
    "typescript": "5.9.2",
    "ultracite": "7.2.4",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
