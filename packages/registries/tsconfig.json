{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "paths": {
      "@/components/ui/*": [
        "./kit/registry/base-nova/ui/*",
        "../ui/src/components/ui/*"
      ],
      "@/*": [
        "../ui/src/*"
      ],
      "@repo/ui/*": [
        "../ui/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
